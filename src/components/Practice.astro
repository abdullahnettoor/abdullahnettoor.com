---
import { practice } from "../data/siteData";
---
<section class="practice" id="practice" aria-labelledby="practice-title">
  <div class="shell section-intro">
    <div class="section-note"><p class="micro">Engineering practice</p><p>The work I enjoy sits between a product question and a system that has to keep its promises.</p></div>
    <div>
      <h2 class="section-title" id="practice-title">The work between an idea and a reliable system.</h2>
      <div class="throughline">
        {practice.map((item) => <article class="practice-step"><span>{item.stage}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><div class="example"><strong>In practice</strong>{item.example}</div></article>)}
      </div>
    </div>
  </div>
</section>
