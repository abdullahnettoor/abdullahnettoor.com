---
import { profile, projects } from "../data/siteData";

const featuredProjects = projects.filter((project) => project.featured).sort((a, b) => a.order - b.order);
const projectHref = (project: (typeof projects)[number]) => project.caseStudy
  ? `/work/${project.id}`
  : project.liveUrl ?? project.repositoryUrl ?? "#work";
const isExternal = (href: string) => href.startsWith("http");
---
<section class="selected" id="work" aria-labelledby="work-title">
  <div class="shell">
    <div class="selected-head"><div><p class="micro">Selected work</p><h2 id="work-title">Proof, kept compact.</h2></div><a class="text-link" href={profile.social.github} target="_blank" rel="noopener noreferrer">All repositories ↗</a></div>
    <div class="work-list">
      {featuredProjects.map((project) => {
        const href = projectHref(project);
        return <a class="work-row" href={href} target={isExternal(href) ? "_blank" : undefined} rel={isExternal(href) ? "noopener noreferrer" : undefined}><h3>{project.name}</h3><p>{project.summary}</p><span class="work-type">{project.type.join(" · ")}</span><span aria-hidden="true">↗</span></a>;
      })}
    </div>
  </div>
</section>
